      "name": "Download audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "useapiHeaderAuth",
          "name": "useapi.net API token"
        }
      },
      "retryOnFail": true,
