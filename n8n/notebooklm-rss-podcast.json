        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ notebook: $('Create notebook').item.json.notebook, type: 'audio', mode: 'async', format: $('Newest posts').item.json.format, length: $('Newest posts').item.json.length, language: $('Newest posts').item.json.language }) }}"
      },
      "name": "Generate Audio Overview",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "useapiHeaderAuth",
          "name": "useapi.net API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 20
      },
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2200,
        200
      ],
      "webhookId": "b3c4d5e6-7f80-4b92-8c1d-2e3f4a5b6c7d"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.useapi.net/v1/gemini-notebook/jobs/' + encodeURIComponent($('Generate Audio Overview').item.json.jobid) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Check job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
