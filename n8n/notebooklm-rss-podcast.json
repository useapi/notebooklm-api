{
  "name": "Turn new RSS posts into a weekly NotebookLM podcast",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "name": "Every Monday at 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "feedUrl",
              "value": "https://blog.google/technology/ai/rss/",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "showName",
              "value": "Weekly AI digest",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "maxPosts",
              "value": 5,
              "type": "number"
            },
            {
              "id": "r4",
              "name": "lookbackDays",
              "value": 7,
              "type": "number"
            },
            {
              "id": "r5",
              "name": "format",
              "value": "deep_dive",
              "type": "string"
            },
            {
              "id": "r6",
              "name": "length",
              "value": "default",
              "type": "string"
            },
            {
              "id": "r7",
              "name": "language",
              "value": "en",
              "type": "string"
            },
            {
              "id": "r8",
              "name": "email",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Feed settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.feedUrl }}",
        "options": {}
      },
      "name": "Read feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep the posts published within lookbackDays, newest first, at most maxPosts.\n// No new posts: return nothing, so no episode is made this week.\nconst s = $('Feed settings').first().json;\nconst since = Date.now() - s.lookbackDays * 24 * 3600 * 1000;\nconst date = p => Date.parse(p.isoDate || p.pubDate || '');\nconst posts = $input.all().map(i => i.json)\n  .filter(p => p.link && date(p) >= since)\n  .sort((a, b) => date(b) - date(a))\n  .slice(0, s.maxPosts);\nif (posts.length === 0) return [];\nreturn [{ json: {\n  title: `${s.showName}, ${new Date().toISOString().slice(0, 10)}`,\n  urls: posts.map(p => p.link),\n  posts: posts.map(p => p.title),\n  format: s.format, length: s.length, language: s.language, email: s.email,\n}, pairedItem: { item: 0 } }];"
      },
      "name": "Newest posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.useapi.net/v1/gemini-notebook/notebooks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 320000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ title: $('Newest posts').item.json.title }, $('Newest posts').item.json.email ? { email: $('Newest posts').item.json.email } : {})) }}"
      },
      "name": "Create notebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "useapiHeaderAuth",
          "name": "useapi.net API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.useapi.net/v1/gemini-notebook/sources",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 320000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ notebook: $('Create notebook').item.json.notebook, urls: $('Newest posts').item.json.urls }) }}"
      },
      "name": "Add sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "useapiHeaderAuth",
          "name": "useapi.net API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 10
      },
      "name": "Wait 10s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        300
      ],
      "webhookId": "a2b3c4d5-6e7f-4a81-9b0c-1d2e3f4a5b6c"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.useapi.net/v1/gemini-notebook/notebooks/' + encodeURIComponent($('Create notebook').item.json.notebook) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "name": "Check sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "useapiHeaderAuth",
          "name": "useapi.net API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.sources.every(s => s.status === 'ready' || s.status === 'error') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Sources ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        300
